table 'FaitBudget'

	column 'Date'
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: Date

	column 'NoCompte'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: NoCompte

	column 'Montant'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: Montant

	column 'MontantSigne'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: MontantSigne

	partition 'FaitBudget' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "FaitBudget.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"Date", type date}, {"NoCompte", Int64.Type}, {"Montant", type number}, {"MontantSigne", type number}}, "en-US")
				in
				    Types
