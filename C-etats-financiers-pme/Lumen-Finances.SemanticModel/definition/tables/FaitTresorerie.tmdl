table 'FaitTresorerie'

	column 'DebutSemaine'
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: DebutSemaine

	column 'CategorieFlux'
		dataType: string
		summarizeBy: none
		sourceColumn: CategorieFlux

	column 'Montant'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: Montant

	column 'TypeDonnee'
		dataType: string
		summarizeBy: none
		sourceColumn: TypeDonnee

	partition 'FaitTresorerie' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "FaitTresorerie.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"DebutSemaine", type date}, {"CategorieFlux", type text}, {"Montant", type number}, {"TypeDonnee", type text}}, "en-US")
				in
				    Types
