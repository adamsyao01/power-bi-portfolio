table 'DimCompte'

	column 'NoCompte'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: NoCompte

	column 'Compte'
		dataType: string
		summarizeBy: none
		sourceColumn: Compte

	column 'Categorie'
		dataType: string
		summarizeBy: none
		sourceColumn: Categorie
		sortByColumn: 'OrdreCategorie'

	column 'SousCategorie'
		dataType: string
		summarizeBy: none
		sourceColumn: SousCategorie

	column 'OrdreCategorie'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: OrdreCategorie

	column 'Signe'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Signe

	column 'CompteAffiche'
		dataType: string
		summarizeBy: none
		sourceColumn: CompteAffiche
		sortByColumn: 'NoCompte'

	partition 'DimCompte' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "DimCompte.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"NoCompte", Int64.Type}, {"Compte", type text}, {"Categorie", type text}, {"SousCategorie", type text}, {"OrdreCategorie", Int64.Type}, {"Signe", Int64.Type}, {"CompteAffiche", type text}}, "en-US")
				in
				    Types
