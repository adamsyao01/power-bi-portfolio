table 'StructurePL'

	column 'Ordre'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Ordre

	column 'LignePL'
		dataType: string
		summarizeBy: none
		sourceColumn: LignePL
		sortByColumn: 'Ordre'

	column 'TypeLigne'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: TypeLigne

	partition 'StructurePL' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "StructurePL.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"Ordre", Int64.Type}, {"LignePL", type text}, {"TypeLigne", type text}}, "en-US")
				in
				    Types
