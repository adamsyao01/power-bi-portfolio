table 'DimCauseCondamnation'

	column 'CauseID'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: CauseID

	column 'Cause'
		dataType: string
		summarizeBy: none
		sourceColumn: Cause
		sortByColumn: 'CauseID'

	partition 'DimCauseCondamnation' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "DimCauseCondamnation.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"CauseID", Int64.Type}, {"Cause", type text}}, "en-US")
				in
				    Types
