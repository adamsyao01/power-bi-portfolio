table 'DimRegion'

	column 'RegionID'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: RegionID

	column 'Region'
		dataType: string
		summarizeBy: none
		sourceColumn: Region
		sortByColumn: 'RegionID'

	partition 'DimRegion' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "DimRegion.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"RegionID", Int64.Type}, {"Region", type text}}, "en-US")
				in
				    Types
