table 'DimComposante'

	column 'Composante'
		dataType: string
		summarizeBy: none
		sourceColumn: Composante
		sortByColumn: 'Ordre'

	column 'Groupe'
		dataType: string
		summarizeBy: none
		sourceColumn: Groupe

	column 'Ordre'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Ordre

	partition 'DimComposante' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "DimComposante.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"Composante", type text}, {"Groupe", type text}, {"Ordre", Int64.Type}}, "en-US")
				in
				    Types
