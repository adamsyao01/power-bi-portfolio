table 'FaitCondamnation'

	column 'LotID'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: LotID

	column 'CauseID'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: CauseID

	column 'KgCondamnes'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: KgCondamnes

	partition 'FaitCondamnation' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "FaitCondamnation.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"LotID", Int64.Type}, {"CauseID", Int64.Type}, {"KgCondamnes", type number}}, "en-US")
				in
				    Types
