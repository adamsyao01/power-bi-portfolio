expression DossierDonnees = "C:\Users\yaoad\consul power-bi\portfolio\projets-fictifs\A-approvisionnement-v2\data\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	annotation PBI_ResultType = Text

expression LotsBruts =
		let
		    Source = Csv.Document(File.Contents(DossierDonnees & "FaitReceptionLot.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		    Types = Table.TransformColumnTypes(Entetes, {{"LotID", Int64.Type}, {"NoLot", type text}, {"DateAbattage", type date}, {"ProducteurID", Int64.Type}, {"TypePouletID", Int64.Type}, {"TransporteurID", Int64.Type}, {"TetesRecues", Int64.Type}, {"MortsEnCage", Int64.Type}, {"KgVifsRecus", type number}, {"KgMortsEnCage", type number}, {"KgCondamnes", type number}, {"KgPayes", type number}, {"MontantPrixBase", type number}, {"MontantAjustement", type number}, {"MontantBonification", type number}, {"MontantChargement", type number}, {"MontantTransport", type number}}, "en-US")
		in
		    Types
	annotation PBI_ResultType = Table

expression BudgetJour =
		let
		    Budget = let
		        Source = Csv.Document(File.Contents(DossierDonnees & "FaitBudgetPeriode.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		        Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		        Types = Table.TransformColumnTypes(Entetes, {{"Exercice", Int64.Type}, {"NoPeriode", Int64.Type}, {"CleExercicePeriode", Int64.Type}, {"TypePouletID", Int64.Type}, {"Region", type text}, {"KgPayesBudget", type number}, {"MontantPrixBaseBudget", type number}, {"MontantAjustementBudget", type number}, {"MontantBonificationBudget", type number}, {"MontantChargementBudget", type number}, {"MontantTransportBudget", type number}}, "en-US")
		    in
		        Types,
		    Dates = Table.SelectColumns(DimDate, {"Date", "CleExercicePeriode"}),
		    Joint = Table.NestedJoin(Budget, {"CleExercicePeriode"}, Dates, {"CleExercicePeriode"}, "D", JoinKind.Inner),
		    Jours = Table.ExpandTableColumn(Joint, "D", {"Date"}),
		    ParJour = Table.TransformColumns(Jours, List.Transform({"KgPayesBudget", "MontantPrixBaseBudget", "MontantAjustementBudget", "MontantBonificationBudget", "MontantChargementBudget", "MontantTransportBudget"}, (c) => {c, each _ / 28, type number}))
		in
		    ParJour
	annotation PBI_ResultType = Table
