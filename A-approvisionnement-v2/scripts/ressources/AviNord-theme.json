{
  "name": "AviNord",
  "dataColors": ["#1F3A5F", "#E07A1F", "#8A9BB0", "#2E8B57", "#C0392B", "#5B7DA8", "#F2B279", "#4A4F57"],
  "background": "#FFFFFF",
  "foreground": "#1F2A37",
  "tableAccent": "#1F3A5F",
  "good": "#2E8B57",
  "bad": "#C0392B",
  "neutral": "#E07A1F",
  "maximum": "#1F3A5F",
  "center": "#8A9BB0",
  "minimum": "#F4F6F9",
  "textClasses": {
    "callout": {"fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#1F3A5F"},
    "title": {"fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F3A5F"},
    "header": {"fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1F3A5F"},
    "label": {"fontFace": "Segoe UI", "fontSize": 10, "color": "#4A4F57"}
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [{"show": true, "color": {"solid": {"color": "#E3E7EC"}}, "radius": 8}],
        "background": [{"show": true, "color": {"solid": {"color": "#FFFFFF"}}, "transparency": 0}],
        "dropShadow": [{"show": false}],
        "padding": [{"top": 8, "bottom": 8, "left": 10, "right": 10}]
      }
    },
    "page": {
      "*": {
        "background": [{"color": {"solid": {"color": "#F4F6F9"}}, "transparency": 0}],
        "outspace": [{"color": {"solid": {"color": "#F4F6F9"}}, "transparency": 0}]
      }
    },
    "textbox": {"*": {"border": [{"show": false}], "background": [{"show": false}], "padding": [{"top": 0, "bottom": 0, "left": 0, "right": 0}]}},
    "image": {"*": {"border": [{"show": false}], "background": [{"show": false}], "padding": [{"top": 0, "bottom": 0, "left": 0, "right": 0}]}},
    "slicer": {"*": {"border": [{"show": false}], "background": [{"show": false}]}},
    "tableEx": {"*": {
      "columnHeaders": [{"backColor": {"solid": {"color": "#1F3A5F"}}, "fontColor": {"solid": {"color": "#FFFFFF"}}}],
      "values": [{"backColorSecondary": {"solid": {"color": "#F4F6F9"}}}]
    }},
    "pivotTable": {"*": {
      "columnHeaders": [{"backColor": {"solid": {"color": "#1F3A5F"}}, "fontColor": {"solid": {"color": "#FFFFFF"}}}],
      "rowHeaders": [{"fontColor": {"solid": {"color": "#1F2A37"}}}],
      "values": [{"backColorSecondary": {"solid": {"color": "#F4F6F9"}}}]
    }}
  }
}
