table 'fact_production'

	column 'Date'
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: Date

	column 'CodeUsine'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: CodeUsine

	column 'CodeLigne'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: CodeLigne

	column 'Quart'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Quart

	column 'CodeProduit'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: CodeProduit

	column 'MinutesOuvertes'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: MinutesOuvertes

	column 'UnitesProduites'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: UnitesProduites

	column 'UnitesRejetees'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: UnitesRejetees

	column 'MinutesArretPlanifie'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: MinutesArretPlanifie

	column 'MinutesArretNonPlanifie'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: MinutesArretNonPlanifie

	column 'NbArretsNonPlanifies'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: NbArretsNonPlanifies

	column 'TempsRequisMin'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: TempsRequisMin

	column 'TempsFonctionnementMin'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: TempsFonctionnementMin

	column 'UnitesTheoriques'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: UnitesTheoriques

	column 'UnitesBonnes'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: UnitesBonnes

	partition 'fact_production' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "fact_production.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"Date", type date}, {"CodeUsine", type text}, {"CodeLigne", type text}, {"Quart", type text}, {"CodeProduit", type text}, {"MinutesOuvertes", type number}, {"UnitesProduites", type number}, {"UnitesRejetees", type number}, {"MinutesArretPlanifie", type number}, {"MinutesArretNonPlanifie", type number}, {"NbArretsNonPlanifies", type number}, {"TempsRequisMin", type number}, {"TempsFonctionnementMin", type number}, {"UnitesTheoriques", type number}, {"UnitesBonnes", type number}}, "en-US")
				in
				    Types
