table 'dim_date'
	dataCategory: Time

	column 'Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		isKey
		summarizeBy: none
		sourceColumn: Date

	column 'Annee'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Annee

	column 'NoMois'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: NoMois

	column 'Mois'
		dataType: string
		summarizeBy: none
		sourceColumn: Mois
		sortByColumn: 'NoMois'

	column 'AnneeMois'
		dataType: string
		summarizeBy: none
		sourceColumn: AnneeMois
		sortByColumn: 'CleAnneeMois'

	column 'CleAnneeMois'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: CleAnneeMois

	column 'SemaineISO'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: SemaineISO

	column 'JourSemaine'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: JourSemaine

	partition 'dim_date' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"Date", type date}, {"Annee", Int64.Type}, {"NoMois", Int64.Type}, {"Mois", type text}, {"AnneeMois", type text}, {"CleAnneeMois", Int64.Type}, {"SemaineISO", Int64.Type}, {"JourSemaine", Int64.Type}}, "en-US")
				in
				    Types
