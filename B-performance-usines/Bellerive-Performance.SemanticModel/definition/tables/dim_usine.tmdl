table 'dim_usine'

	column 'CodeUsine'
		dataType: string
		summarizeBy: none
		sourceColumn: CodeUsine

	column 'Usine'
		dataType: string
		summarizeBy: none
		sourceColumn: Usine

	column 'Region'
		dataType: string
		summarizeBy: none
		sourceColumn: Region

	column 'CourrielDirecteur'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: CourrielDirecteur

	partition 'dim_usine' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "dim_usine.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"CodeUsine", type text}, {"Usine", type text}, {"Region", type text}, {"CourrielDirecteur", type text}}, "en-US")
				in
				    Types
