table 'dim_ligne'

	column 'CodeLigne'
		dataType: string
		summarizeBy: none
		sourceColumn: CodeLigne

	column 'CodeUsine'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: CodeUsine

	column 'Ligne'
		dataType: string
		summarizeBy: none
		sourceColumn: Ligne

	column 'TypeLigne'
		dataType: string
		summarizeBy: none
		sourceColumn: TypeLigne

	column 'CadenceIdealeUnitesMin'
		dataType: double
		formatString: 0
		summarizeBy: none
		sourceColumn: CadenceIdealeUnitesMin

	partition 'dim_ligne' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "dim_ligne.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"CodeLigne", type text}, {"CodeUsine", type text}, {"Ligne", type text}, {"TypeLigne", type text}, {"CadenceIdealeUnitesMin", type number}}, "en-US")
				in
				    Types
