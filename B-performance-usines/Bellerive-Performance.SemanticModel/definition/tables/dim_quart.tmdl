table 'dim_quart'

	column 'Quart'
		dataType: string
		summarizeBy: none
		sourceColumn: Quart
		sortByColumn: 'OrdreQuart'

	column 'OrdreQuart'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: OrdreQuart

	column 'HeureDebut'
		dataType: string
		summarizeBy: none
		sourceColumn: HeureDebut

	partition 'dim_quart' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "dim_quart.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"Quart", type text}, {"OrdreQuart", Int64.Type}, {"HeureDebut", type text}}, "en-US")
				in
				    Types
